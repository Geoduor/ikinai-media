# Postgres connection strings (Supabase or Neon). Use the SAME database for
# local dev and Vercel production for now — simplest setup while the site is
# small.
#
# Supabase gives you two different connection strings when you click
# "Connect" on your project dashboard (ORM tab -> Prisma):
#   DATABASE_URL = the pooled connection (port 6543) - used by the running app
#   DIRECT_URL   = the direct connection (port 5432) - used only for migrations
# Prisma needs both because Supabase's pooler (PgBouncer, transaction mode)
# doesn't support the features Prisma Migrate needs.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Long random secret used to sign admin session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Used once, by the seed script, to create the first admin account.
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="choose-a-strong-password"
